{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@my-app/expo",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:web": "npm run dev --workspace=@my-app/next",
    "dev:expo": "npm run start --workspace=@my-app/expo",
    "postinstall": "patch-package",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "patch-package": "^8.0.1",
    "supabase": "^2.76.9",
    "turbo": "^2.8.1",
    "typescript": "^5.1.6"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-reanimated": "4.1.6",
    "react-native-worklets": "0.5.1"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
