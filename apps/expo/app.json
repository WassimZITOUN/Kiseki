{
  "expo": {
    "name": "MyApp",
    "slug": "my-app",
    "scheme": "myapp",
    "version": "1.0.0",
    "icon": "../assets/Icon/android/play_store_512.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "../assets/splash_screens/splash_screens/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "icon": "../assets/Icon/android/play_store_512.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.kiseki.app",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Kiseki t'envoie des notifications pour te rappeler de voter et decouvrir les resultats."
      }
    },
    "android": {
      "package": "com.kiseki.app",
      "adaptiveIcon": {
        "foregroundImage": "../assets/Icon/android/res/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "../assets/Icon/android/res/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "../assets/Icon/android/res/mipmap-xxxhdpi/ic_launcher_monochrome.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "../assets/Icon/ios/AppIcon-20@2x.png",
          "color": "#9572CF",
          "iosDisplayInForeground": true
        }
      ]
    ],
    "autolinking": {
      "buildFromSource": ["expo-blur"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "548c9d57-0a07-46f4-afeb-e2177f3c3fbf"
      }
    }
  }
}
