{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@my-app/core": ["packages/core/src"],
      "@my-app/core/*": ["packages/core/src/*"],
      "@my-app/types": ["packages/types/src"],
      "@my-app/types/*": ["packages/types/src/*"]
    },
    "types": []
  }
}
